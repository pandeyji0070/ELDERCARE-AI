    "CircleInvite": {
      "title": "CircleInvite",
      "description": "Single-use invite code allowing a verified Google user to join an existing Care Circle with an assigned role.",
      "type": "object",
      "properties": {
        "inviteCode": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "circleId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "elderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "invitedRole": {
          "type": "string",
          "enum": ["elderly", "caretaker", "family"]
        },
        "invitedEmail": {
          "type": "string",
          "maxLength": 160
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "revoked"]
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "acceptedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "acceptedByEmail": {
          "type": "string",
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "inviteCode",
        "circleId",
        "ownerId",
        "elderName",
        "invitedRole",
        "status",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-only user profile with PII email and active dashboard view preference."
    },
    "/careCircles/{circleId}": {
      "schema": { "$ref": "#/entities/CareCircle" },
      "description": "Master Gate care circle document for an elderly resident."
    },
    "/careCircles/{circleId}/members/{memberUid}": {
      "schema": { "$ref": "#/entities/CircleMember" },
      "description": "Authorized care circle members and assigned roles."
    },
    "/careCircles/{circleId}/medications/{medId}": {
      "schema": { "$ref": "#/entities/Medication" },
      "description": "Medication schedules and refill counts."
    },
    "/careCircles/{circleId}/doseLogs/{logId}": {
      "schema": { "$ref": "#/entities/DoseLog" },
      "description": "Daily medication adherence logs."
    },
    "/careCircles/{circleId}/appointments/{apptId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Doctor appointments and visit notes."
    },
    "/careCircles/{circleId}/sosEvents/{sosId}": {
      "schema": { "$ref": "#/entities/SosEvent" },
      "description": "Confirmed demo-only SOS events."
    },
    "/careCircles/{circleId}/notificationLogs/{logId}": {
      "schema": { "$ref": "#/entities/NotificationLog" },
      "description": "Immutable log of email notification checks and SMTP dispatch attempts."
    },
    "/careCircles/{circleId}/aiRoutines/{routineId}": {
      "schema": { "$ref": "#/entities/AiRoutine" },
      "description": "Saved Gemini AI health routine plans."
    },
    "/circleInvites/{inviteCode}": {
      "schema": { "$ref": "#/entities/CircleInvite" },
      "description": "Invite records authorizing a verified user to join a Care Circle with a fixed role."
    }
  }
}
