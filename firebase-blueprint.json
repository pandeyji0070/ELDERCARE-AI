        },
        "morningPlan": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "afternoonPlan": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "eveningPlan": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "safetyTip": {
